---
import Base from '../layouts/Base.astro';
import { SITE_NAME, DEFAULT_CONTACT_EMAIL } from '../lib/site';
import { getEnv } from '../lib/db';
import { MAX_AMOUNT } from '../lib/pricing';
import { num } from '../lib/format';

const contact = getEnv(Astro.locals).CONTACT_EMAIL ?? DEFAULT_CONTACT_EMAIL;
---

<Base
  title={`特定商取引法に基づく表記 — ${SITE_NAME}`}
  description={`${SITE_NAME}の特定商取引法に基づく表記`}
>
  <article class="prose">
    <h1>特定商取引法に基づく表記</h1>

    <table>
      <tbody>
        <tr>
          <th>販売事業者</th>
          <td>請求があった場合、遅滞なく開示します。</td>
        </tr>
        <tr>
          <th>所在地</th>
          <td>請求があった場合、遅滞なく開示します。</td>
        </tr>
        <tr>
          <th>電話番号</th>
          <td>請求があった場合、遅滞なく開示します。</td>
        </tr>
        <tr>
          <th>連絡先</th>
          <td><a href={`mailto:${contact}`}>{contact}</a></td>
        </tr>
        <tr>
          <th>販売価格</th>
          <td>
            100円以上、100円単位（上限 <span class="lat">{num(MAX_AMOUNT)}</span>円）。
            掲載手続きの画面に表示される金額が販売価格です。消費税を含みます。
          </td>
        </tr>
        <tr>
          <th>商品代金以外の必要料金</th>
          <td>なし。インターネット接続にかかる通信費はお客様のご負担となります。</td>
        </tr>
        <tr>
          <th>支払方法</th>
          <td>クレジットカード</td>
        </tr>
        <tr>
          <th>支払時期</th>
          <td>掲載手続き時に即時決済されます。</td>
        </tr>
        <tr>
          <th>役務の提供時期</th>
          <td>決済完了後、ただちにランキングへ反映されます。</td>
        </tr>
        <tr>
          <th>返品・キャンセル</th>
          <td>
            デジタル役務の性質上、決済完了後の返金・キャンセルは受け付けません。
            利用規約違反により掲載を削除した場合も返金しません。
          </td>
        </tr>
        <tr>
          <th>販売数量の制限等</th>
          <td>
            順位は掲載金額のみで決まります。決済のタイミングにより他の掲載の金額が変動しうるため、
            特定の順位を保証するものではありません。
          </td>
        </tr>
      </tbody>
    </table>
  </article>
</Base>
