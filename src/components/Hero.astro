---
/**
 * 統計ピル・見出し・金額ステッパー・掲載フォーム。要件定義書 4.5 / 4.6。
 *
 * 見出しの金額はそのまま掲載金額になる。初期値はカテゴリ内1位を取る額。
 */
import { ALL, CATEGORIES, DEFAULT_CATEGORY, heroLabel, type ViewSlug } from '../lib/categories';
import { MIN_AMOUNT, STEP, MAX_AMOUNT, priceForTop } from '../lib/pricing';
import { num, yen } from '../lib/format';
import type { VisitorStats } from '../lib/visitors';

interface Props {
  view: ViewSlug;
  categoryTop: number;
  listingCount: number;
  visitors: VisitorStats;
}

const { view, categoryTop, listingCount, visitors } = Astro.props;

const amount = priceForTop(categoryTop);
const selected = view === ALL ? DEFAULT_CATEGORY : view;
---

<section class="hero">
  <div class="pill-stat">
    <span class="dot"></span><b>{num(visitors.online)}人</b><span>が閲覧中</span>
    <span class="sep">·</span><span>累計 <span class="lat">{num(visitors.total)}</span>人</span>
    <span class="sep">·</span><span>掲載 <span class="lat">{num(listingCount)}</span>件</span>
  </div>

  <h1>
    <span id="heroLabel">{heroLabel(view)}</span>
    <span class="stepper">
      <button class="step" id="dec" type="button" aria-label="100円下げる">−</button>
      <span class="amount lat" id="heroAmount">{yen(amount)}</span>
      <button class="step" id="inc" type="button" aria-label="100円上げる">＋</button>
    </span>
  </h1>

  <p class="lead">
    <span class="em">掲載は100円から。</span>
    1位の金額を下回っても、その金額で入れる順位にそのまま掲載されます。
  </p>

  <form method="get" action="/confirm" id="listingForm">
    <label class="field">
      <svg
        width="21"
        height="21"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18"></path>
      </svg>
      <input
        type="url"
        name="url"
        id="urlInput"
        required
        autocomplete="url"
        placeholder="掲載したいURL または @ハンドル"
        aria-label="掲載したいURL"
      />
    </label>
    <div class="selectwrap">
      <select id="catSelect" name="category" aria-label="カテゴリ">
        {CATEGORIES.map((c) => <option value={c.slug} selected={c.slug === selected}>{c.label}</option>)}
      </select>
      <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M6 9l6 6 6-6"></path>
      </svg>
    </div>
    <input type="hidden" name="amount" id="amountInput" value={amount} />
    <button class="submit" type="submit">掲載する</button>
  </form>

  <p class="note">すでに掲載されている場合は、同じURLを入力すると金額を上げられます。</p>
</section>

<script
  is:inline
  define:vars={{ MIN_AMOUNT, STEP, MAX_AMOUNT, amount }}
>
  (() => {
    const label = document.getElementById('heroAmount');
    const field = document.getElementById('amountInput');
    const urlInput = document.getElementById('urlInput');
    const select = document.getElementById('catSelect');
    let value = amount;

    const render = () => {
      label.textContent = value.toLocaleString('ja-JP') + '円';
      field.value = String(value);
    };
    const move = (delta) => {
      value = Math.min(MAX_AMOUNT, Math.max(MIN_AMOUNT, value + delta));
      render();
    };

    document.getElementById('inc').addEventListener('click', () => move(STEP));
    document.getElementById('dec').addEventListener('click', () => move(-STEP));

    // 4.6: フォームのカテゴリを変えたときもチップとランキングを連動させる。
    // 打ちかけのURLは遷移で失われるので持ち越す。
    const KEY = 'nib:url';
    try {
      const kept = sessionStorage.getItem(KEY);
      if (kept && !urlInput.value) urlInput.value = kept;
      sessionStorage.removeItem(KEY);
    } catch (_) {}

    select.addEventListener('change', () => {
      try {
        if (urlInput.value) sessionStorage.setItem(KEY, urlInput.value);
      } catch (_) {}
      location.href = '/c/' + select.value;
    });
  })();
</script>
